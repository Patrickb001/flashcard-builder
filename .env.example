# Copy to .env and fill in. .env is git-ignored; this file is not.
#
# The key is read by the server side only - the dev server in vite.config.ts
# and the Netlify function - and never reaches the browser. Without it the
# app still runs: card drafting falls back to its rule-based generator, and
# you can paste your own key into the AI settings panel instead.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5
